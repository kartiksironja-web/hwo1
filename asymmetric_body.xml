<mujoco model="asymmetric_body">

    <option gravity="0 0 0"/>

    <worldbody>

        <body name="asymmetric_body" pos="0 0 0">

            <!-- Main rectangular body -->
            <geom
                type="box"
                size="0.6 0.25 0.15"
                rgba="0.2 0.6 0.9 1"/>

            <!-- Asymmetric extension -->
            <geom
                type="box"
                pos="0.45 0.25 0.1"
                size="0.15 0.1 0.3"
                rgba="0.9 0.3 0.2 1"/>

            <!-- X axis marker -->
            <geom
                type="cylinder"
                pos="0.8 0 0"
                size="0.03 0.8"
                quat="0 0.707 0 0.707"
                rgba="1 0 0 1"/>

        </body>

    </worldbody>

</mujoco>
